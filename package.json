{
  "name": "garuda",
  "version": "0.2.1",
  "description": "Garuda: a terminal coding agent.",
  "type": "module",
  "private": true,
  "bin": {
    "garuda": "dist/cli/index.js"
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "format": "biome format --write .",
    "test": "vitest run",
    "check": "pnpm typecheck && pnpm lint && pnpm test",
    "package": "tsup && node scripts/package.mjs",
    "startup": "node scripts/startup.mjs",
    "eval": "node dist/cli/index.js eval"
  },
  "packageManager": "pnpm@10.28.0",
  "dependencies": {
    "@anthropic-ai/sdk": "^0.128.0",
    "@inquirer/prompts": "^8.7.2",
    "@modelcontextprotocol/client": "^2.1.0",
    "commander": "^15.0.0",
    "diff": "^9.0.0",
    "globby": "^16.2.4",
    "ink": "^7.1.1",
    "ipaddr.js": "^2.5.0",
    "node-html-markdown": "^2.0.0",
    "react": "^19.3.0",
    "ts6": "npm:typescript@^6.0.3",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.14",
    "@modelcontextprotocol/server": "^2.1.0",
    "@types/node": "^22.20.4",
    "@types/react": "^19.3.0",
    "ink-testing-library": "^4.0.0",
    "tsup": "^8.5.1",
    "typescript": "^7.0.2",
    "vitest": "^5.0.1"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
