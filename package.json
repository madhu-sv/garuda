{
  "name": "@garuda-agent/garuda",
  "version": "0.17.0",
  "description": "Garuda: a terminal coding agent with an OS sandbox, approvals and an audit log.",
  "license": "Apache-2.0",
  "author": "Madhusudhan Vasanth Kumar",
  "homepage": "https://madhu-sv.github.io/garuda/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/madhu-sv/garuda.git"
  },
  "bugs": "https://github.com/madhu-sv/garuda/issues",
  "keywords": [
    "coding-agent",
    "cli",
    "terminal",
    "sandbox",
    "anthropic",
    "claude",
    "mcp",
    "ai",
    "ai-agent",
    "agent",
    "llm",
    "ollama",
    "openrouter",
    "acp",
    "agent-client-protocol",
    "zed",
    "code-assistant"
  ],
  "type": "module",
  "bin": {
    "garuda": "dist/cli/index.js"
  },
  "files": [
    "dist/**/*.js",
    "LICENSE",
    "NOTICE",
    "README.md",
    "SECURITY.md",
    "CHANGELOG.md",
    "native/garuda-reap.c",
    "native/bin/garuda-reap"
  ],
  "engines": {
    "node": "^22.23.4 || ^24.22.1 || >=26.12.1"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup && node scripts/build-native.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "format": "biome format --write .",
    "test": "node scripts/build-native.mjs && vitest run",
    "check": "pnpm typecheck && pnpm lint && pnpm test",
    "package": "tsup && node scripts/package.mjs",
    "startup": "node scripts/startup.mjs",
    "models:check": "node scripts/check-models.mjs",
    "ipi:mutations": "node scripts/check-ipi-mutations.mjs",
    "eval": "node dist/cli/index.js eval",
    "baseline:capture": "node scripts/capture-quality-baseline.mjs",
    "code-intelligence:validate": "vitest run test/lspReferenceSample.test.ts test/codeIntelligenceSample.test.ts --reporter=verbose",
    "code-intelligence:capture": "node scripts/capture-reference-oracle.mjs",
    "prepack": "pnpm build",
    "build:native": "node scripts/build-native.mjs"
  },
  "packageManager": "pnpm@10.28.0",
  "dependencies": {
    "@agentclientprotocol/sdk": "1.7.0",
    "@anthropic-ai/sdk": "^0.128.0",
    "@inquirer/prompts": "^8.7.2",
    "@modelcontextprotocol/client": "^2.3.1",
    "commander": "^15.0.0",
    "diff": "^9.0.0",
    "globby": "^16.2.4",
    "ink": "^7.1.1",
    "ipaddr.js": "^2.5.0",
    "node-html-markdown": "^2.0.0",
    "react": "^19.3.0",
    "smol-toml": "^1.9.0",
    "ts6": "npm:typescript@^6.0.3",
    "undici": "^7.30.1",
    "vscode-jsonrpc": "^9.0.3",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.14",
    "@modelcontextprotocol/server": "^2.3.1",
    "@types/node": "^22.20.4",
    "@types/react": "^19.3.0",
    "ink-testing-library": "^4.0.0",
    "tsup": "^8.5.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ],
    "overrides": {
      "esbuild": "^0.28.2"
    },
    "auditConfig": {
      "ignoreGhsas": [
        "GHSA-vfj7-8cjw-p6xm"
      ]
    }
  }
}
